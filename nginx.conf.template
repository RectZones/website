server {
    listen       ${PORT};
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    gzip on;
    gzip_types text/plain text/css text/xml application/xml application/json image/svg+xml;

    add_header X-Content-Type-Options nosniff;

    # Unknown paths are a real 404, so crawlers do not see the landing page under every URL.
    error_page 404 /404.html;
    location / {
        try_files $uri $uri/ =404;
    }

    # Fingerprint-free static assets: long cache, revalidated by Cloudflare in front.
    location ~* \.(png|webp|jpg|ico|woff2)$ {
        expires 30d;
        add_header X-Content-Type-Options nosniff;
    }
}
